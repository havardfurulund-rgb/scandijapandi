---
// Chapter page, shared by /kitanote/[maker], /kitanote/en/[maker] and
// /kitanote/no/[maker]. The hero follows the opening plate: film 2/3, ink
// plate 1/3 with the mark, the Japanese title (stacked by phrase), the Latin
// title and the maker label.
import KitaLayout from './KitaLayout.astro';
import KitaMark from './KitaMark.astro';
import LoopVideo from './LoopVideo.astro';
import Film from './Film.astro';
import JpTitle from './JpTitle.astro';
import Tag from './Tag.astro';
import Objects from './Objects.astro';
import {
  HTML_LANG, LANGS, UI, abs, chapterUrl, issueUrl, isoDuration, known, latinLang, loadIssue, pad, paragraphs, splitDraft, t, tn,
  type Chapter, type Lang,
} from '../../lib/kitanote';

interface Props { lang: Lang; slug: string }
const { lang, slug } = Astro.props;
const ui = UI[lang];
const latin = latinLang(lang);
const isJa = lang === 'ja';
const pageLang = HTML_LANG[lang];
const { issue, chapters } = await loadIssue();
const index = chapters.findIndex((c) => c.slug === slug);
const c: Chapter = chapters[index];
const next: Chapter | undefined = chapters[index + 1];

const issueLabel = ui.issueLabel(pad(issue.number), t(issue.season, lang));
const number = pad(index + 1);
const latinTitle = t(c.title, latin);
const makerLine = [c.maker_name, c.maker_person].filter(Boolean).join(' · ');
const filmTitle = `${c.title.ja} ${latinTitle}`;

// Interview flow: intro text, then Q&A, with pull quotes placed after a given
// answer (`after`), or straight after the intro when omitted.
type Block = { kind: 'text'; intro?: string[]; qa: { q: string; a: string }[] } | { kind: 'quote'; quote: Chapter['quotes'][number] };
const blocks: Block[] = [];
const quotesAfter = (i: number) => c.quotes.filter((q) => (q.after ?? -1) === i);
let current: Block = { kind: 'text', intro: c.body ? paragraphs(t(c.body, lang)) : [], qa: [] };
const flush = () => {
  if (current.kind === 'text' && ((current.intro?.length ?? 0) > 0 || current.qa.length > 0)) blocks.push(current);
  current = { kind: 'text', qa: [] };
};
quotesAfter(-1).forEach((q) => { flush(); blocks.push({ kind: 'quote', quote: q }); });
c.interview.forEach((item, i) => {
  if (current.kind === 'text') current.qa.push({ q: t(item.q, lang), a: t(item.a, lang) });
  const qs = quotesAfter(i);
  if (qs.length) { flush(); qs.forEach((q) => blocks.push({ kind: 'quote', quote: q })); }
});
flush();

// Photographs laid out in pairs by orientation so a landscape frame never
// ends up postage-stamp sized next to a tall portrait.
const isLandscape = (g: { width: number; height: number }) => g.width > g.height;
const PAIRS: Record<string, [string, string]> = {
  PP: ['md:col-span-5 md:col-start-2', 'md:col-span-4 md:col-start-8 md:mt-[12vw]'],
  LP: ['md:col-span-7', 'md:col-span-4 md:col-start-9 md:mt-[10vw]'],
  PL: ['md:col-span-4 md:col-start-2', 'md:col-span-6 md:col-start-7 md:mt-[16vw]'],
  LL: ['md:col-span-7', 'md:col-span-6 md:col-start-7 md:mt-[6vw]'],
};
const MOBILE = ['col-span-4', 'col-span-3 col-start-2'];
const galleryClass = c.gallery.map((_, i) => {
  const pairStart = i - (i % 2);
  const a = c.gallery[pairStart];
  const b = c.gallery[pairStart + 1];
  if (!b) return `${MOBILE[0]} md:col-span-6 md:col-start-4 md:mt-[8vw]`;
  const key = `${isLandscape(a) ? 'L' : 'P'}${isLandscape(b) ? 'L' : 'P'}`;
  return `${MOBILE[i % 2]} ${PAIRS[key][i % 2]}`;
});

const ogImage = c.og_image ?? c.hero_loop?.poster ?? issue.og_image;
const description = t(c.dek, lang);
const publisher = { '@type': 'Organization', name: 'Scandi Japandi Collection', url: 'https://scandijapandi.no' };
const jsonLd: object[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: filmTitle,
    description,
    inLanguage: pageLang,
    url: abs(chapterUrl(lang, c.slug)),
    image: ogImage ? abs(ogImage) : undefined,
    datePublished: issue.published_at.toISOString().slice(0, 10),
    author: { '@type': 'Organization', name: '北の手 Kita no Te' },
    publisher,
    isPartOf: { '@type': 'PublicationIssue', issueNumber: String(issue.number), name: `${issue.title.ja} · ${t(issue.title, latin)}`, url: abs(issueUrl(lang)) },
  },
];
if (c.film) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'VideoObject',
    name: filmTitle,
    description,
    thumbnailUrl: [abs(c.film.poster)],
    uploadDate: issue.published_at.toISOString().slice(0, 10),
    duration: isoDuration(c.film.duration),
    contentUrl: abs(c.film.src),
    inLanguage: 'ja',
    publisher,
  });
}

const meta = [
  { label: ui.maker, value: c.maker_person ? `${c.maker_name}, ${c.maker_person}` : c.maker_name },
  { label: ui.place, value: t(c.location, lang) },
  { label: ui.craft, value: t(c.craft, lang) },
].filter((m) => known(m.value));

const paths = Object.fromEntries(LANGS.map((l) => [l, chapterUrl(l, c.slug)])) as Record<Lang, string>;
---

<KitaLayout
  lang={lang}
  title={`${c.title.ja} ${latinTitle} — 北の手 Kita no Te`}
  description={description}
  paths={paths}
  ogImage={ogImage}
  ogType="article"
  issueLabel={issueLabel}
  jsonLd={jsonLd}
  noindex={!c.jp_qa || !issue.jp_qa}
>
  <!-- 1 · Hero: film 2/3, ink plate 1/3 -->
  <section class="kt-split" aria-labelledby="kt-title">
    {c.hero_loop && <LoopVideo loop={c.hero_loop} lang={lang} eager class="kt-split__media" />}
    <div class="kt-split__plate kt-ink">
      <a href={issueUrl(lang)} class="self-start p-1" aria-label={`北の手 · Kita no Te — ${ui.backToIssue}`}>
        <KitaMark size={56} draw />
      </a>
      <div class="kt-plate-title">
        <h1 id="kt-title">
          <JpTitle text={c.title.ja} stack class="block" />
          <span class="kt-latin block" lang={HTML_LANG[latin]}>{latinTitle}</span>
        </h1>
        <p class="kt-label kt-plate-label mt-7">{makerLine} · {isJa ? `第${Number(number)}章` : `Ep. ${number}`}</p>
      </div>
      <div class="flex flex-col gap-5">
        {(!c.jp_qa || c.draft || c.title_draft) && (
          <p class="flex flex-wrap gap-3">
            {!c.jp_qa && <Tag lang={lang} kind="jpQa" />}
            {c.draft && <Tag lang={lang} kind="draft" />}
            {c.title_draft && <Tag lang={lang} kind="titleDraft" />}
          </p>
        )}
        <p class="kt-label kt-label--sm kt-plate-foot"><span lang="ja">北の手</span> · Kita no Te · {issueLabel}</p>
      </div>
    </div>
  </section>

  <!-- 2 · Dek + facts -->
  <header class="kt-wrap pt-16 md:pt-28">
    <div class="kt-grid gap-y-10">
      <dl class="col-span-4 grid grid-cols-2 gap-x-6 gap-y-6 self-start md:col-span-3 md:grid-cols-1">
        {meta.map((m) => (
          <div>
            <dt class="kt-label kt-label--sm kt-stone" lang={pageLang}>{m.label}</dt>
            <dd class="mt-1.5 text-[0.9375rem] leading-snug" lang={pageLang}>{m.value}</dd>
          </div>
        ))}
        {c.website && (
          <div>
            <dt class="kt-label kt-label--sm kt-stone" lang={pageLang}>{ui.website}</dt>
            <dd class="mt-1.5 text-[0.9375rem]"><a href={c.website} class="kt-link" rel="noopener">{c.website.replace(/^https?:\/\//, '').replace(/\/$/, '')}</a></dd>
          </div>
        )}
      </dl>
      <p class="kt-lede col-span-4 md:col-span-7 md:col-start-5 lg:col-span-6 lg:col-start-5" lang={pageLang}>{description}</p>
    </div>
  </header>

  <!-- 3 · Main film -->
  {c.film && (
    <section class="kt-wrap pt-20 md:pt-32" aria-label={`${ui.film}: ${filmTitle}`}>
      <div class="kt-reveal">
        <Film film={c.film} title={filmTitle} lang={lang} />
      </div>
    </section>
  )}

  <!-- 4 · Conversation -->
  <article class="kt-section" aria-label={ui.conversation}>
    {blocks.map((b, bi) =>
      b.kind === 'text' ? (
        <div class="kt-wrap kt-grid gap-y-8">
          <div class="col-span-4 md:col-span-3">
            {bi === 0 && <p class="kt-label kt-stone">{ui.conversation}</p>}
          </div>
          <div class="kt-body col-span-4 md:col-span-7 md:col-start-5 lg:col-span-6 lg:col-start-5" lang={pageLang}>
            {b.intro?.map((p) => <p class="kt-reveal">{p}</p>)}
            {b.qa.map((item) => {
              const a = splitDraft(item.a);
              return (
                <div class="kt-reveal !mt-14 md:!mt-16">
                  <p class:list={['text-ink', isJa ? 'kt-jp !tracking-[0.08em] text-[1.1875rem] md:text-[1.3125rem]' : 'kt-latin text-[1.3125rem] md:text-[1.5rem]']}>{item.q}</p>
                  <p class="mt-5">
                    {a.draft && <Tag lang={lang} kind="draft" class="mr-3 -translate-y-px" />}
                    {a.text}
                  </p>
                </div>
              );
            })}
          </div>
        </div>
      ) : (
        (() => {
          const jp = splitDraft(b.quote.text.ja);
          const own = splitDraft(t(b.quote.text, lang));
          return (
            <figure class="kt-wrap kt-grid kt-quote kt-reveal my-24 md:my-36">
              <blockquote class="col-span-4 md:col-span-8 md:col-start-3">
                <p class="kt-jp" lang="ja">「{jp.text}」</p>
                {!isJa && <p class="kt-latin kt-second mt-5" lang={pageLang}>“{own.text}”</p>}
              </blockquote>
              <figcaption class="kt-label kt-label--sm kt-stone col-span-4 mt-8 flex flex-wrap items-center gap-4 md:col-span-8 md:col-start-3">
                {(b.quote.draft || jp.draft) && <Tag lang={lang} kind="draft" />}
                {b.quote.attribution && !(b.quote.draft || jp.draft) && <span>{b.quote.attribution}</span>}
              </figcaption>
            </figure>
          );
        })()
      ),
    )}
  </article>

  <!-- 5 · Photographs -->
  {c.gallery.length > 0 && (
    <section class="pb-[clamp(5rem,12vw,11rem)]" aria-label={ui.gallery}>
      <div class="kt-wrap">
        <div class="kt-grid mb-12 md:mb-16">
          <p class="kt-label kt-stone col-span-4 md:col-span-3">{ui.gallery}</p>
        </div>
        <div class="kt-grid gap-y-14 md:gap-y-0">
          {c.gallery.map((g, i) => (
            <figure class:list={['kt-reveal', galleryClass[i], i >= 2 && i % 2 === 0 && 'md:mt-[8vw]']}>
              <div class="kt-media" style={`aspect-ratio: ${g.width} / ${g.height}`}>
                <img
                  src={g.src}
                  srcset={g.src_small ? `${g.src_small} ${Math.round(g.width / 2)}w, ${g.src} ${g.width}w` : undefined}
                  sizes="(min-width: 768px) 50vw, 92vw"
                  width={g.width}
                  height={g.height}
                  alt={t(g.alt, lang)}
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <figcaption class="kt-label kt-label--sm kt-stone mt-4 flex gap-4">
                <span class="kt-num">{pad(i + 1)}</span>
                <span>{g.caption ? t(g.caption, lang) : g.placeholder ? ui.placeholderMedia : g.credit}</span>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- 6 · この回の作品 -->
  <Objects lang={lang} slugs={c.product_slugs} producerMatch={c.producer_name_match} storySlug={c.story_slug} />

  {c.credits.length > 0 && (
    <section class="kt-wrap kt-grid gap-y-8 py-16 md:py-20" aria-label={ui.credits}>
      <p class="kt-label kt-label--sm kt-stone col-span-4 md:col-span-3">{ui.credits}</p>
      <dl class="col-span-4 grid grid-cols-2 gap-x-8 gap-y-6 md:col-span-8 md:col-start-5 md:grid-cols-3">
        {c.credits.map((cr) => (
          <div>
            <dt class="kt-label kt-label--sm kt-stone" lang={pageLang}>{t(cr.role, lang)}</dt>
            <dd class="mt-1.5 text-[0.9375rem]" lang={pageLang}>{tn(cr.name, lang)}</dd>
          </div>
        ))}
      </dl>
    </section>
  )}

  <!-- 7 · Next chapter: image + ink plate, like the hero -->
  {(() => {
    const target = next ?? null;
    const loop = target?.hero_loop ?? issue.cover_loop;
    return (
      <a href={target ? chapterUrl(lang, target.slug) : `${issueUrl(lang)}#contents`} class="group kt-split kt-split--short">
        <div class="kt-media kt-zoom kt-split__media">
          <picture>
            {loop.poster_mobile && <source media="(max-width: 767px)" srcset={loop.poster_mobile} width="720" height="900" />}
            <img src={loop.poster} width="1200" height="900" alt={t(loop.alt, lang)} loading="lazy" decoding="async" />
          </picture>
        </div>
        <div class="kt-split__plate kt-ink">
          <p class="kt-label kt-plate-label">{target ? `${ui.next} · ${pad(index + 2)}` : issueLabel}</p>
          <div class="kt-plate-title">
            {target ? (
              <p>
                <JpTitle text={target.title.ja} stack class="block" />
                <span class="kt-latin block" lang={HTML_LANG[latin]}>{t(target.title, latin)}</span>
              </p>
            ) : (
              <p class={isJa ? 'kt-jp text-[clamp(1.75rem,2.6vw,2.5rem)]' : 'kt-latin text-[clamp(1.75rem,2.6vw,2.5rem)]'}>{ui.backToIssue}</p>
            )}
          </div>
          <p class="kt-label kt-label--sm kt-plate-foot flex items-center gap-3">
            {target ? target.maker_name : ui.contents} <span class="kt-arrow" aria-hidden="true">→</span>
          </p>
        </div>
      </a>
    );
  })()}
</KitaLayout>

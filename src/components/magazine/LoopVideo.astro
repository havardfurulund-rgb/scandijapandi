---
// Muted ambient loop (cover, chapter hero). The poster is a real <picture> so
// it can be the LCP element and swap to a 4:5 crop on phones. The video has
// no src until magazine.client.ts sees it near the viewport, and never plays
// under prefers-reduced-motion or Save-Data.
import { UI, t, type Lang } from '../../lib/magazine';

interface Props {
  loop: {
    src: string;
    src_mobile?: string;
    type: 'mp4' | 'hls';
    poster: string;
    poster_small?: string;
    poster_mobile?: string;
    alt?: { no: string; en: string };
  };
  lang: Lang;
  /** Above the fold: load the poster eagerly with high priority. */
  eager?: boolean;
  scrim?: boolean;
  class?: string;
}

const { loop, lang, eager = false, scrim = true, class: className } = Astro.props;
const ui = UI[lang];
const mime = loop.type === 'hls' ? 'application/vnd.apple.mpegurl' : 'video/mp4';
---

<div class:list={['mz-media mz-loop', className]} data-loop>
  <picture>
    {loop.poster_mobile && <source media="(max-width: 767px)" srcset={loop.poster_mobile} width="720" height="900" />}
    <img
      src={loop.poster}
      srcset={loop.poster_small ? `${loop.poster_small} 800w, ${loop.poster} 1600w` : undefined}
      sizes="100vw"
      width="1600"
      height="900"
      alt={t(loop.alt, lang)}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
      decoding={eager ? 'sync' : 'async'}
    />
  </picture>
  <video muted loop playsinline preload="none" aria-hidden="true" tabindex="-1" disablepictureinpicture>
    {loop.src_mobile && <source data-src={loop.src_mobile} type={mime} media="(max-width: 767px)" />}
    <source data-src={loop.src} type={mime} />
  </video>
  {scrim && <div class="mz-scrim" aria-hidden="true"></div>}
  <slot />
  <button
    type="button"
    class="mz-motion-toggle mz-kicker mz-kicker--sm"
    data-motion-toggle
    data-label-pause={ui.pauseMotion}
    data-label-play={ui.playMotion}
    aria-pressed="false"
    hidden
  >{ui.pauseMotion}</button>
</div>

---
// Main chapter film. Click-to-play: nothing but the poster loads until the
// reader asks for it. Native controls appear once playing; captions in both
// languages, the page language on by default. `type: hls` plays natively
// where supported and falls back to `src_fallback` (MP4) elsewhere.
import { UI, formatDuration, type Lang } from '../../lib/magazine';
import DraftTag from './DraftTag.astro';

interface Props {
  film: {
    src: string;
    type: 'mp4' | 'hls';
    src_fallback?: string;
    poster: string;
    poster_small?: string;
    duration: number;
    captions_no?: string;
    captions_en?: string;
    placeholder: boolean;
  };
  title: string;
  lang: Lang;
}

const { film, title, lang } = Astro.props;
const ui = UI[lang];
const duration = formatDuration(film.duration);
const hasCaptions = Boolean(film.captions_no || film.captions_en);
---

<figure>
  <div class="mz-film" data-film data-src={film.src} data-type={film.type} data-fallback={film.src_fallback}>
    <video preload="none" playsinline aria-label={`${ui.film}: ${title}`}>
      {film.captions_no && <track kind="captions" src={film.captions_no} srclang="nb" label="Norsk" default={lang === 'no'} />}
      {film.captions_en && <track kind="captions" src={film.captions_en} srclang="en" label="English" default={lang === 'en'} />}
    </video>
    <button type="button" class="mz-film__play" aria-label={`${ui.playFilm}: ${title}, ${duration}`}>
      <picture>
        <img
          src={film.poster}
          srcset={film.poster_small ? `${film.poster_small} 800w, ${film.poster} 1600w` : undefined}
          sizes="(min-width: 1520px) 1400px, 92vw"
          width="1600"
          height="900"
          alt=""
          loading="lazy"
          decoding="async"
        />
      </picture>
      <span class="mz-scrim" aria-hidden="true"></span>
      <span class="mz-film__label" aria-hidden="true">
        <span class="mz-film__tri"></span>
        <span class="mz-kicker">{ui.watchFilm}</span>
        <span class="mz-kicker opacity-70">{duration}</span>
      </span>
    </button>
  </div>
  <figcaption class="mt-5 flex flex-wrap items-baseline justify-between gap-x-8 gap-y-3">
    <span class="mz-serif mz-italic text-[1.0625rem] text-ink/80">{title}</span>
    <span class="mz-kicker mz-kicker--sm mz-stone flex items-center gap-4">
      {film.placeholder && <DraftTag lang={lang} label={ui.placeholderMedia} />}
      <span>{ui.film} · {duration}{hasCaptions && ` · ${ui.withCaptions}`}</span>
    </span>
  </figcaption>
</figure>

---
import { UI, issueUrl, type Lang } from '../../lib/magazine';

interface Props {
  lang: Lang;
  paths: Record<Lang, string>;
  issueLabel: string;
}
const { lang, paths, issueLabel } = Astro.props;
const ui = UI[lang];
const other: Lang = lang === 'no' ? 'en' : 'no';
---

<header class="absolute inset-x-0 top-0 z-30 text-paper mz-on-dark">
  <div class="mz-wrap flex h-[4.5rem] items-center justify-between md:h-24">
    <a href={issueUrl(lang)} class="mz-serif text-[1.1875rem] leading-none tracking-[-0.01em] md:text-[1.375rem]">
      {lang === 'en' ? 'Hands of the North' : 'Hender fra Nord'}
    </a>
    <p class="mz-kicker mz-kicker--sm hidden opacity-80 md:block">{issueLabel}</p>
    <nav aria-label={lang === 'no' ? 'Magasin' : 'Magazine'} class="flex items-center gap-6 md:gap-10">
      <a
        href={paths[other]}
        hreflang={other === 'no' ? 'nb' : 'en'}
        lang={other === 'no' ? 'nb' : 'en'}
        class="mz-kicker mz-kicker--sm opacity-80 transition-opacity hover:opacity-100"
        data-lang-switch={other}
      >
        <span class="sr-only">{ui.otherLangLabel}: </span><span aria-hidden="true">{ui.otherLangShort}</span>
      </a>
      <a href="/" class="mz-kicker mz-kicker--sm opacity-80 transition-opacity hover:opacity-100">
        {ui.shop} <span class="mz-arrow" aria-hidden="true">→</span>
      </a>
    </nav>
  </div>
  <p class="mz-wrap -mt-2 flex justify-end" data-lang-hint hidden>
    <a
      href={paths[other]}
      hreflang={other === 'no' ? 'nb' : 'en'}
      lang={other === 'no' ? 'nb' : 'en'}
      class="mz-kicker mz-kicker--sm mz-link opacity-90"
      data-lang-switch={other}
    >{ui.langHint} <span class="mz-arrow" aria-hidden="true">→</span></a>
  </p>
</header>

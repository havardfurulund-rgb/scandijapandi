---
// Shell for every «Hender fra Nord» page: Base (fonts, meta, cookie banner)
// plus the magazine's own light nav and footer. Prerendered, no framework JS.
import Base from '../../layouts/Base.astro';
import '../../styles/magazine.css';
import MagazineNav from './MagazineNav.astro';
import MagazineFooter from './MagazineFooter.astro';
import { UI, abs, type Lang } from '../../lib/magazine';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** This page in each language, for hreflang and the language switch. */
  paths: Record<Lang, string>;
  ogImage?: string;
  ogType?: string;
  jsonLd?: object[];
  issueLabel: string;
}

const { lang, title, description, paths, ogImage, ogType = 'website', jsonLd = [], issueLabel } = Astro.props;
const ui = UI[lang];
const alternates = [
  { hreflang: 'nb', href: abs(paths.no) },
  { hreflang: 'en', href: abs(paths.en) },
  { hreflang: 'x-default', href: abs(paths.no) },
];
// "</script>" inside copy must not close the JSON-LD tag early.
const ld = (o: object) => JSON.stringify(o).replace(/</g, '\\u003c');
---

<Base
  title={title}
  description={description}
  lang={ui.htmlLang}
  alternates={alternates}
  ogImage={ogImage ? abs(ogImage) : undefined}
  ogType={ogType}
  ogLocale={ui.ogLocale}
  asyncFonts
>
  <Fragment slot="head">
    <!-- Fraunces italic for decks, signatures and captions (same host as the base fonts). -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@1,9..144,300&display=swap" media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@1,9..144,300&display=swap" /></noscript>
    <script is:inline>document.documentElement.classList.add('mz-js');</script>
    {jsonLd.map((o) => <script type="application/ld+json" set:html={ld(o)} />)}
    <slot name="head" />
  </Fragment>

  <div class="mz" data-mz-lang={lang}>
    <a href="#main" class="mz-skip mz-kicker">{ui.skip}</a>
    <MagazineNav lang={lang} paths={paths} issueLabel={issueLabel} />
    <main id="main">
      <slot />
    </main>
    <MagazineFooter lang={lang} paths={paths} issueLabel={issueLabel} />
  </div>
</Base>

<script>
  import { initMagazine } from './magazine.client';
  initMagazine();
</script>

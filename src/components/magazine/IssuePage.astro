---
// Issue front page, shared by /hender-fra-nord and /en/hands-of-the-north.
import MagazineLayout from './MagazineLayout.astro';
import LoopVideo from './LoopVideo.astro';
import DraftTag from './DraftTag.astro';
import {
  UI, BASE, abs, chapterUrl, formatDuration, known, loadIssue, monthYear, pad, paragraphs, t, type Lang,
} from '../../lib/magazine';

interface Props { lang: Lang }
const { lang } = Astro.props;
const ui = UI[lang];
const { issue, chapters, coming } = await loadIssue();

const issueLabel = `${ui.issueShort} ${pad(issue.number)} · ${t(issue.season, lang)}`;
const masthead = t(issue.title, lang).split(' ');
// Two lines: "Hender / fra Nord", "Hands of / the North".
const mastheadLines = [masthead.slice(0, lang === 'no' ? 1 : 2).join(' '), masthead.slice(lang === 'no' ? 1 : 2).join(' ')];
const [lede, ...letter] = paragraphs(t(issue.editor_letter.body, lang));

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'PublicationIssue',
    name: `${t(issue.title, lang)} · ${issueLabel}`,
    issueNumber: String(issue.number),
    datePublished: issue.published_at.toISOString().slice(0, 10),
    inLanguage: ui.htmlLang,
    url: abs(BASE[lang]),
    image: issue.og_image ? abs(issue.og_image) : abs(issue.cover_loop.poster),
    description: t(issue.manifest, lang),
    isPartOf: { '@type': 'Periodical', name: t(issue.title, lang), publisher: { '@type': 'Organization', name: 'Scandi Japandi Collection', url: 'https://scandijapandi.no' } },
    hasPart: chapters.map((c) => ({ '@type': 'Article', headline: `${c.maker_name}: ${t(c.title, lang)}`, url: abs(chapterUrl(lang, c.slug)) })),
  },
];
---

<MagazineLayout
  lang={lang}
  title={`${t(issue.title, lang)} — ${issueLabel} · Scandi Japandi`}
  description={t(issue.manifest, lang)}
  paths={{ no: BASE.no, en: BASE.en }}
  ogImage={issue.og_image ?? issue.cover_loop.poster}
  issueLabel={issueLabel}
  jsonLd={jsonLd}
>
  <!-- 1 · Cover -->
  <section class="relative h-[100svh] min-h-[600px] text-paper mz-on-dark" aria-labelledby="mz-masthead">
    <LoopVideo loop={issue.cover_loop} lang={lang} eager class="!absolute inset-0" />
    <div class="pointer-events-none absolute inset-0 z-[2] flex flex-col justify-end">
      <div class="mz-wrap mz-cover-in pb-20 md:pb-24">
        <p class="mz-kicker flex items-center gap-4">
          <span>{issueLabel}</span>
          {issue.draft && <DraftTag lang={lang} class="pointer-events-auto" />}
        </p>
        <h1 id="mz-masthead" class="mz-masthead mt-6 md:mt-8">
          <span class="block">{mastheadLines[0]}</span>
          <span class="block md:pl-[0.9em]">{mastheadLines[1]}</span>
        </h1>
        <div class="mz-grid mt-8 gap-y-6 md:mt-12">
          <p class="mz-serif mz-italic col-span-4 max-w-[32ch] text-[1.1875rem] leading-[1.45] md:col-span-5 md:text-[1.5rem]">
            {t(issue.manifest, lang)}
          </p>
          <p class="mz-kicker mz-kicker--sm col-span-4 opacity-80 md:col-span-4 md:col-start-9 md:self-end md:text-right md:pr-28">
            {ui.magazineBy}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 2 · From the editor -->
  <section class="mz-section" aria-labelledby="mz-letter">
    <div class="mz-wrap mz-grid gap-y-10">
      <div class="col-span-4 md:col-span-3">
        <p class="mz-kicker mz-stone mz-reveal flex flex-wrap items-center gap-4">
          <span>{ui.editorLetter}</span>
          {issue.editor_letter.draft && <DraftTag lang={lang} />}
        </p>
      </div>
      <div class="col-span-4 md:col-span-8 md:col-start-5 lg:col-span-7 lg:col-start-5">
        <h2 id="mz-letter" class="mz-h2 mz-reveal max-w-[16ch]">{t(issue.editor_letter.title, lang)}</h2>
        <p class="mz-lede mz-reveal mt-12 max-w-[34ch] md:mt-16" style="--d: 80ms">{lede}</p>
        <div class="mz-body mz-reveal mt-10 md:mt-12 md:pl-[16%]" style="--d: 160ms">
          {letter.map((p) => <p>{p}</p>)}
        </div>
        <div class="mz-reveal mt-14 md:mt-16 md:pl-[16%]">
          <p class="mz-serif mz-italic text-[1.75rem] leading-none tracking-[-0.01em]">{issue.editor_letter.signature}</p>
          <p class="mz-kicker mz-kicker--sm mz-stone mt-4">{t(issue.editor_letter.role, lang)}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 3 · Contents -->
  <section id="innhold" class="pb-[clamp(6rem,13vw,12rem)]" aria-labelledby="mz-contents">
    <div class="mz-wrap">
      <div class="mz-grid items-end gap-y-6 pb-10 md:pb-16">
        <p class="mz-kicker mz-stone col-span-4 md:col-span-3">{ui.contents}</p>
        <h2 id="mz-contents" class="mz-h2 col-span-4 md:col-span-6 md:col-start-5">{ui.chaptersInIssue}</h2>
        <p class="mz-kicker mz-kicker--sm mz-stone hidden md:col-span-2 md:col-start-11 md:block md:text-right">
          {ui.chapterCount(chapters.length)}
        </p>
      </div>
      <ol>
        {chapters.map((c, i) => {
          const flip = i % 2 === 1;
          const poster = c.hero_loop;
          const meta = [t(c.craft, lang), t(c.location, lang)].filter(known);
          return (
            <li class="border-t border-ink/10">
              <a href={chapterUrl(lang, c.slug)} class="group block py-10 md:py-16 lg:py-20">
                <div class="mz-grid mz-reveal items-start gap-y-7">
                  <span class="mz-num hidden text-[clamp(3rem,6.4vw,6.75rem)] leading-[0.8] text-stone md:col-span-2 md:block" aria-hidden="true">
                    {pad(i + 1)}
                  </span>
                  {poster && (
                    <div class:list={[
                      'mz-media mz-zoom col-span-4 aspect-[4/3] md:col-span-5 md:row-start-1 md:aspect-[16/11]',
                      flip ? 'md:col-start-8' : 'md:col-start-3',
                    ]}>
                      <img
                        src={poster.poster_small ?? poster.poster}
                        srcset={poster.poster_small ? `${poster.poster_small} 800w, ${poster.poster} 1600w` : undefined}
                        sizes="(min-width: 768px) 40vw, 92vw"
                        width="800"
                        height="450"
                        alt={t(poster.alt, lang)}
                        loading="lazy"
                        decoding="async"
                      />
                    </div>
                  )}
                  <div class:list={[
                    'col-span-4 md:row-start-1 md:pt-1',
                    flip ? 'md:col-span-4 md:col-start-3' : 'md:col-span-4 md:col-start-9',
                  ]}>
                    <p class="mz-kicker mz-kicker--sm mz-stone flex flex-wrap items-center gap-x-[0.6em] gap-y-2">
                      <span class="md:hidden">{pad(i + 1)} ·</span>
                      <span>{meta.join(' · ')}</span>
                      {c.film && <span>· {ui.film} {formatDuration(c.film.duration)}</span>}
                    </p>
                    <h3 class="mz-h3 mt-5 transition-colors duration-500 group-hover:text-clay">{c.maker_name}</h3>
                    <p class="mz-serif mz-italic mt-3 text-[1.1875rem] leading-snug text-ink/80">{t(c.title, lang)}</p>
                    <p class="mt-6 max-w-[42ch] text-[0.9375rem] leading-[1.7] text-ink/75">{t(c.dek, lang)}</p>
                    <p class="mz-kicker mz-kicker--sm mt-8 flex items-center gap-4">
                      <span>{ui.readChapter} <span class="mz-arrow" aria-hidden="true">→</span></span>
                      {c.draft && <DraftTag lang={lang} />}
                    </p>
                  </div>
                </div>
              </a>
            </li>
          );
        })}
      </ol>
      <hr class="mz-rule" />
    </div>
  </section>

  <!-- 4 · Coming -->
  {coming.length > 0 && (
    <section id="kommer" class="bg-oat mz-section" aria-labelledby="mz-coming">
      <div class="mz-wrap">
        <div class="mz-grid gap-y-8">
          <p class="mz-kicker mz-stone-deep col-span-4 md:col-span-3">{ui.coming}</p>
          <div class="col-span-4 md:col-span-6 md:col-start-5">
            <h2 id="mz-coming" class="mz-h2 mz-reveal">{ui.comingTitle}</h2>
            <p class="mz-body mz-reveal mt-6 max-w-[44ch] text-ink/80" style="--d: 80ms">{ui.comingBody}</p>
          </div>
        </div>
        <ul class="mz-grid mt-16 gap-y-20 md:mt-28">
          {coming.map((c, i) => (
            <li class:list={[
              'mz-coming mz-reveal col-span-4',
              i % 2 === 0 ? 'md:col-span-5 md:col-start-2' : 'md:col-span-4 md:col-start-8 md:mt-40',
            ]} style={`--d: ${i * 120}ms`}>
              {c.teaser_image && (
                <div class="mz-media aspect-[4/5]">
                  <img src={c.teaser_image} width="720" height="900" alt="" loading="lazy" decoding="async" />
                </div>
              )}
              <p class="mz-kicker mz-kicker--sm mt-7 flex flex-wrap items-center gap-4 text-moss">
                <span>{ui.filming} {c.shoot_date ? monthYear(c.shoot_date, lang) : ''}</span>
              </p>
              <h3 class="mz-h3 mt-4">{c.maker_name}</h3>
              <p class="mz-serif mz-italic mt-3 text-[1.125rem] text-ink/75">{t(c.craft, lang)}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- 5 · Colophon -->
  <section class="mz-section--tight" aria-labelledby="mz-colophon">
    <div class="mz-wrap mz-grid gap-y-14">
      <h2 id="mz-colophon" class="mz-kicker mz-stone col-span-4 md:col-span-3">{ui.colophon}</h2>
      <dl class="col-span-4 grid grid-cols-1 gap-x-10 gap-y-10 sm:grid-cols-2 md:col-span-5 md:col-start-5">
        {issue.colophon.entries.map((e) => (
          <div>
            <dt class="mz-kicker mz-kicker--sm mz-stone">{t(e.role, lang)}</dt>
            <dd class="mz-serif mt-3 text-[1.3125rem] leading-snug">{e.names.join(', ')}</dd>
          </div>
        ))}
      </dl>
      <div class="col-span-4 md:col-span-3 md:col-start-10">
        <p class="mz-kicker mz-kicker--sm mz-stone">{ui.forMakers}</p>
        <p class="mz-serif mt-3 text-[1.3125rem] leading-snug">{ui.newMakers}</p>
        <a href="/makers" class="mz-kicker mz-kicker--sm mz-link mt-6 inline-block">
          {ui.newMakersLink} <span class="mz-arrow" aria-hidden="true">→</span>
        </a>
      </div>
      {issue.colophon.note && (
        <p class="col-span-4 max-w-[60ch] text-[0.875rem] leading-[1.7] mz-stone md:col-span-6 md:col-start-5">
          {t(issue.colophon.note, lang)}
        </p>
      )}
      <p class="mz-kicker mz-kicker--sm col-span-4 md:col-span-6 md:col-start-5">{ui.presentedBy}</p>
    </div>
  </section>
</MagazineLayout>

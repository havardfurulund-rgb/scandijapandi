---
// 北の手 · Kita no Te — chapter page (en). One static page per published chapter.
import ChapterPage from '../../../components/kitanote/ChapterPage.astro';
import { loadIssue } from '../../../lib/kitanote';

export async function getStaticPaths() {
  const { chapters } = await loadIssue();
  return chapters.map((c) => ({ params: { maker: c.slug } }));
}

const { maker } = Astro.params;
---
<ChapterPage lang="en" slug={maker!} />

---
export const prerender = true;
import ChapterPage from '../../../components/magazine/ChapterPage.astro';
import { loadIssue } from '../../../lib/magazine';

export async function getStaticPaths() {
  const { chapters } = await loadIssue();
  return chapters.map((c) => ({ params: { maker: c.slug } }));
}

const { maker } = Astro.params;
---

<ChapterPage lang="en" slug={maker} />
